{
  "manifest_version": 3,
  "name": "Pass GUI Auto-Filler",
  "version": "1.1",
  "description": "Passbolt-style auto-fill for Pass GUI.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}